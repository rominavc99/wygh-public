# App
AUTH_URL="https://TU-URL-PUBLICA"
AUTH_SECRET="genera-32-bytes-aleatorios-con: openssl rand -base64 32"

# Base de datos
DATABASE_URL="file:./data/app.db"

# SMTP (para magic link y boletin). En desarrollo puedes dejar SMTP_HOST
# vacío: el enlace para entrar se imprime en la terminal de `npm run dev`.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="tucorreo@gmail.com"
SMTP_PASS="app-password-de-16-digitos"
EMAIL_FROM="De regreso a casa <tucorreo@gmail.com>"

# Cron (solo si se expone una ruta de disparo; el worker llama la funcion directo)
CRON_SECRET="otra-cadena-larga-aleatoria"

# Admin inicial (para el seed)
ADMIN_NAME="Tu Nombre"
ADMIN_EMAIL="tucorreo@gmail.com"

# Auto-deploy (opcional, ver docs/DESPLIEGUE.md)
# DEPLOY_BRANCH="prod"
# DEPLOY_STAGING_DIR="/ruta/al/clon-de-staging"
