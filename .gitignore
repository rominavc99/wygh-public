# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# database (sqlite) y archivos de usuarios (fotos de respuestas, ver
# src/lib/response-photos.ts — a propósito fuera de public/, ver
# src/app/IMG/respuestas/[filename]/route.ts)
/data/
*.db
*.db-journal

# process manager
.pm2/

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# archivos locales de agentes de código (no son parte del proyecto)
.claude/*.lock
.claude/settings.local.json

# fotos de portada de cada instalación (ver src/lib/hero-photos.ts): se
# sueltan en public/IMG y se sincronizan solas, pero son privadas de cada
# grupo — no van al repo. Las capturas de comunicados/ son con datos de
# demostración.
/public/IMG/*
!/public/IMG/.gitkeep
!/public/IMG/comunicados/

# estado del auto-deploy (ver deploy-watcher.ts)
.deploy-state.json
